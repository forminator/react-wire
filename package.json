{
  "name": "@forminator/react-wire",
  "description": "connect react components with wire",
  "version": "0.7.0",
  "files": [
    "src",
    "dist",
    "index.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forminator/react-wire"
  },
  "type": "module",
  "typings": "./index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "prepare": "husky",
    "pre-commit": "tsc && lint-staged && pnpm lint",
    "toc": "markdown-toc -i README.md",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,json,yml,css,scss,md}'",
    "format:check": "prettier --check '**/*.{js,jsx,ts,tsx,json,yml,css,scss,md}'",
    "lint": "oxlint --deny-warnings src",
    "type:check": "tsc --noEmit",
    "test": "vitest --run --coverage",
    "test:watch": "vitest",
    "test:package": "bash tests/package-e2e.sh",
    "check": "pnpm format:check && pnpm lint && pnpm type:check && pnpm test",
    "build": "pnpm type:check && vite build && prettier --write index.d.ts",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.2",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-istanbul": "^5",
    "husky": "^9",
    "jest-leak-detector": "^29",
    "jsdom": "^30",
    "lint-staged": "^17",
    "markdown-toc": "^1",
    "oxlint": "^1",
    "prettier": "^3",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^6",
    "unplugin-dts": "^1",
    "vite": "^8",
    "vitest": "^5"
  },
  "dependencies": {
    "mitt": "^1.2.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  }
}
